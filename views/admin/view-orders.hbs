
<section>


<h1>All Orders</h1>
<table border="1">
    <thead>
        <tr>
           <!-- <th>Order ID</th>-->
            <th>User Name</th>
            <th>User ID</th>
            <th>Total Amount</th>
            <th>Payment Method</th>
            <th>Status</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        {{#each orders}}
        <tr>
           <!-- <td>{{this._id}}</td>-->
            <td>{{this.userName}}</td>
            <td>{{this.userId}}</td>
            <td>₹{{this.totalAmount}}</td>
            <td>{{this.paymentMethod}}</td>
            <td>{{this.status}}</td>
            <td>{{this.date}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
</section>

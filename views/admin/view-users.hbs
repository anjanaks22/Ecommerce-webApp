<section>


<h1 class="text-center my-4">All Users</h1>

<table class="table table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>User ID</th>
            <th>Name</th>
            <th>Email</th>
            <!--<th>Password</th>-->
           <!-- <th>Actions</th>-->
        </tr>
    </thead>
    <tbody>
        {{#each users}}
        <tr>
            <td>{{this.id}}</td>
            <td>{{this.Name}}</td>
            <td>{{this.Email}}</td>
          <!--  <td>{{this.Password}}</td>-->
            <!--<td>
                <a href="/admin/block-user/{{this._id}}" class="btn btn-danger btn-sm">Block</a>
                <a href="/admin/delete-user/{{this._id}}" class="btn btn-warning btn-sm">Delete</a>
            </td>-->
        </tr>
        {{/each}}
    </tbody>
</table>
</section>

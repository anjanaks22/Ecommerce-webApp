<section>
    <div class="container">
        <div class="row mt-4">
            <a href="/admin/add-product" class="btn btn-success ml-auto">Add Product</a>
        </div>
    <table class="table mt-5" id="productsTable">
  <thead>
    <tr>
      
      <th scope="col">Title</th>
      <th scope="col">Description</th>
      <th scope="col">Price</th>
      <th>Image</th>
      <th>Options</th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
     
      <td style="width:400px;height:50px">{{this.name}}</td>
      <td style="width:500px;height:50px">{{this.description}}</td>
      <td style="width:500px;height:50px">₹{{this.price}}</td>
      <td><img style="width:50px;height:50px"src="/product-images/{{this.id}}.jpg" alt=""></td>
        <td>
        <a href="/admin/edit-product/{{this.id}}" class="btn btn-primary" >Edit</a>
        <a href="/admin/delete-product/{{this.id}}" class="btn btn-danger"onclick="return confirm('Are you want to delete {{this.name}} ?')" >Delete</a>
       
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
</section>

<script>
  $(function (){
    $('#productsTable').DataTable();
  })
</script>

<!-- HTML with embedded CSS -->
<style>
  body {
    background-color: #f0f2f5;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  .product-section {
    background: linear-gradient(135deg, #e6f7ff 0%, #e6f0ff 100%);
    padding: 40px 0;
    border-radius: 15px;
    margin: 20px 0;
  }
  
  .section-title {
    text-align: center;
    margin-bottom: 30px;
    color: #2e4057;
    font-weight: 700;
    position: relative;
    padding-bottom: 15px;
  }
  
  .section-title:after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 3px;
    background: #4361ee;
  }
  
  .product-card {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    margin-bottom: 20px;
    background-color: white;
    border: 1px solid #eaeaea;
  }
  
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }
  
  .product-img-container {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background-color: #fafafa;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .product-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  
  .product-body {
    padding: 20px;
    background-color: white;
  }
  
  .product-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: #2e4057;
    min-height: 40px;
  }
  
  .product-description {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 15px;
    min-height: 40px;
  }
  
  .product-price {
    font-size: 1.3rem;
    font-weight: 700;
    color: #e63946;
    margin-bottom: 15px;
  }
  
  .add-to-cart-btn {
    background-color: #4361ee;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 10px 15px;
    font-weight: 500;
    transition: all 0.3s ease;
    width: 100%;
  }
  
  .add-to-cart-btn:hover {
    background-color: #3a56d4;
    transform: scale(1.03);
  }
</style>

<section class="product-section">
  <div class="container mt-5">
    <h2 class="section-title">Featured Products</h2>
    <div class="row">
      {{#each products}}
      <div class="col-md-3 col-sm-6 p-3">
        <div class="product-card">
          <div class="product-img-container">
            <img class="product-img"
              src="/product-images/{{this.id}}.jpg"
              alt="{{this.name}}">
          </div>
          <div class="product-body">
            <h5 class="product-title">{{this.name}}</h5>
            <p class="product-description">{{this.description}}</p>
            <p class="product-price">₹{{this.price}}</p>
            
           <button onclick="addToCart('{{this.id}}')" class="add-to-cart-btn">Add to cart</button>
         
          
           

          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
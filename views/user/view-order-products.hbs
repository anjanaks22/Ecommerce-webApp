<section>
  <div class="container mt-5">
    <div class="row">
      {{#each products}}
      <div class="col-md-3 p-3">
        <div class="card">
          <div class="card-img-container">
            <img class="card-img-top" src="/product-images/{{this.product_id}}.jpg" alt="{{this.name}}">
          </div>
          <div class="card-body">
            <h5 class="card-title">{{this.name}}</h5>
            <p class="card-text">Rs.{{this.price}}</p>
            <p class="card-text">Quantity: {{this.quantity}}</p>
            <p class="card-text">{{this.description}}</p>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<style>
  /* Product Cards Styling with Improved Image Handling */
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

  section {
    padding: 60px 0;
    background-color: #f8f9fa;
    min-height: 100vh;
    font-family: 'Poppins', sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .row {
    margin: 0 -15px;
    display: flex;
    flex-wrap: wrap;
  }

  .col-md-3 {
    padding: 15px;
    transition: transform 0.3s ease;
  }

  .col-md-3:hover {
    transform: translateY(-10px);
  }

  /* Card styling with fixed dimensions */
  .card {
    border: none;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    height: 24rem;
    width: 15rem;
    position: relative;
    background-color: white;
    margin: 0 auto;
  }

  .card:hover {
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
  }


 
  .card-img-container {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background-color: #fafafa;
    border-bottom: 1px solid #f0f0f0;
  }
  
  .card-img-top {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  
  .card-body {
    padding: 20px;
    background-color: white;
  }




  /* Image container with proper overflow handling */
  /*.card-img-container {
    height: 12rem;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .card-img-top {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .card:hover .card-img-top {
    transform: scale(1.02);
  }

  .card-body {
    padding: 15px;
    position: relative;
    height: 12rem;
    overflow: hidden;
  }*/

  .card-title {
    font-size: 16px;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 8px;
    line-height: 1.3;
    height: 40px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .card-text {
    margin-bottom: 5px;
    font-size: 14px;
    color: #7f8c8d;
  }

  .card-text:nth-of-type(1) {
    font-weight: 600;
    color: #2980b9;
    font-size: 16px;
  }

  .card-text:nth-of-type(2) {
    font-weight: 500;
    color: #34495e;
  }

  .card-text:nth-of-type(3) {
    font-size: 13px;
    color: #95a5a6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.4;
  }

  /* Fix for image aspect ratio issues */
  img {
    max-width: 100%;
    vertical-align: middle;
  }

  /* Responsive adjustments */
  @media (max-width: 1200px) {
    .col-md-3 {
      width: 33.333%;
    }
  }

  @media (max-width: 992px) {
    .col-md-3 {
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    .col-md-3 {
      width: 100%;
    }

    .card {
      max-width: 280px;
      width: 100%;
    }
  }

  /* Animation for cards when they appear */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .col-md-3 {
    animation: fadeIn 0.5s ease forwards;
    opacity: 0;
  }

  /* Staggered animation delay for cards */
  .col-md-3:nth-child(1) {
    animation-delay: 0.1s;
  }

  .col-md-3:nth-child(2) {
    animation-delay: 0.2s;
  }

  .col-md-3:nth-child(3) {
    animation-delay: 0.3s;
  }

  .col-md-3:nth-child(4) {
    animation-delay: 0.4s;
  }

  .col-md-3:nth-child(5) {
    animation-delay: 0.5s;
  }

  .col-md-3:nth-child(6) {
    animation-delay: 0.6s;
  }

  .col-md-3:nth-child(7) {
    animation-delay: 0.7s;
  }

  .col-md-3:nth-child(8) {
    animation-delay: 0.8s;
  }
</style>









